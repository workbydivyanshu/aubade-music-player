# Aubade — AppImage desktop entry.
# Same identity as aubade.desktop, but Exec is the bare binary name:
# inside the AppImage the executable lives at $APPDIR/usr/bin and there
# is no /opt/aubade (that absolute path belongs to the deb/rpm layout).
# Used ONLY by the CI AppImage step; see .github/workflows/desktop.yml.
[Desktop Entry]
Name=Aubade
Comment=Desktop music player — YouTube Music, lossless audio, Last.fm scrobbling
Exec=aubade %F
Icon=aubade
Terminal=false
Type=Application
Categories=Audio;Music;AudioVideo;
StartupWMClass=com.aubade.desktop
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/wav;audio/x-wav;audio/vnd.wave;audio/aiff;audio/x-aiff;audio/x-ape;audio/x-ms-wma;audio/x-musepack;audio/x-wavpack;audio/x-matroska;audio/aac;audio/x-flac;
