[Desktop Entry]
Name=Aubade
Comment=from an audiophile to an audiophile. a local first music player
Exec=/usr/bin/aubade %U
Icon=aubade
Terminal=false
Type=Application
Categories=Audio;Music;Player;AudioVideo;
StartupWMClass=com.aubade.desktop
MimeType=audio/flac;audio/mp3;audio/x-matroska;audio/ogg;audio/wav;audio/aac;audio/m4a;
